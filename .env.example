# ===========================================
# SilverBullet Configuration
# ===========================================

# --- Docker Image ---
# Vendored image (updated weekly by vendor-images.yml workflow).
# To pin to a specific digest for reproducibility:
# Example: ghcr.io/korjavin/silverbullet-vendor:latest@sha256:<digest>
# Check vendor-digests.log in the deploy branch for the latest digest.
SILVERBULLET_IMAGE=ghcr.io/korjavin/silverbullet-vendor:latest

# --- Container Name ---
SILVERBULLET_CONTAINER_NAME=silverbullet

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default

# --- Traefik Configuration ---
SILVERBULLET_HOST=silverbullet.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# --- Space (notes) Storage ---
# Absolute path on the host where your notes are stored.
# SilverBullet auto-detects the UID/GID of this directory and runs as that user.
# Create the directory first: mkdir -p /path/to/silverbullet/space
SPACE_PATH=/path/to/silverbullet/space

# --- SilverBullet Application ---
SB_PORT=3000
SB_HOSTNAME=0.0.0.0
SB_INDEX_PAGE=index

# --- Optional: Built-in Auth (usually not needed with forward-auth) ---
# If you want a second layer of auth in addition to traefik forward-auth,
# uncomment and set this. Format: username:password
# SB_USER=admin:change-me-to-strong-password
